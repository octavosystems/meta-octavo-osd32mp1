From 21cb3ca90a1968fd6d45ea040d7051d1286fe24b Mon Sep 17 00:00:00 2001
From: neeraj dantu <dantuguf14105@gmail.com>
Date: Fri, 14 Mar 2025 14:19:59 -0500
Subject: [PATCH 2/2] Enable fdtfile environement variable generation for non
 ST boards

---
 board/st/stm32mp1/stm32mp1.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/board/st/stm32mp1/stm32mp1.c b/board/st/stm32mp1/stm32mp1.c
index 9b912a8024..5b9f2b3047 100644
--- a/board/st/stm32mp1/stm32mp1.c
+++ b/board/st/stm32mp1/stm32mp1.c
@@ -871,6 +871,7 @@ int board_late_init(void)
 	char buf[10];
 	char dtb_name[256];
 	int buf_len;
+	size_t org_len;
 
 	if (IS_ENABLED(CONFIG_VIDEO_LCD_RAYDIUM_RM68200) && board_is_stm32mp15x_ev1())
 		board_stm32mp15x_ev1_init();
@@ -883,7 +884,13 @@ int board_late_init(void)
 						 &fdt_compat_len);
 		if (fdt_compat && fdt_compat_len) {
 			if (strncmp(fdt_compat, "st,", 3) != 0) {
-				env_set("board_name", fdt_compat);
+				org_len = strchrnul(fdt_compat, ',') - (const char *)fdt_compat;
+				env_set("board_name", fdt_compat + org_len + 1);
+				buf_len = sizeof(dtb_name);
+				strncpy(dtb_name, fdt_compat + org_len + 1, buf_len);
+				buf_len -= strlen(fdt_compat + org_len + 1);
+				strncat(dtb_name, ".dtb", buf_len);
+				env_set("fdtfile", dtb_name);
 			} else {
 				env_set("board_name", fdt_compat + 3);
 
